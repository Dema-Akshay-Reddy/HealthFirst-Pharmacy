# Copy to .env and adjust. Everything is optional — defaults run the local demo.

# --- server ----------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000
# PHARMACY_ENV=production          # disables /docs unless PHARMACY_DOCS=1

# --- security ----------------------------------------------------------------
# Protect every /api route with a shared key (demo default: auth off).
# SPA prompts once and stores it; CSV downloads use ?api_key=.
# PHARMACY_API_KEY=change-me-long-random

# Cross-origin frontends (comma-separated). Same-origin SPA needs none.
# PHARMACY_CORS_ORIGINS=https://pharmacy.example.com

# --- paths (Docker/test harness override these) ------------------------------
# PHARMACY_DATA_DIR=/app/data
# PHARMACY_DB_PATH=/app/data/pharmacy.db
# PHARMACY_DATASET_DIR=/app/dataset

# --- behaviour -----------------------------------------------------------------
# PHARMACY_SEED_ON_START=1
# PHARMACY_LOG_LEVEL=INFO
