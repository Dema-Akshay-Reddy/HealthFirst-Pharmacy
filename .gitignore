data/models/
data/weather_cache/
data/zenith/*.csv

# cloudflare worker (cloudflare/wrangler.jsonc + src are tracked)
cloudflare/node_modules/
cloudflare/.wrangler/
cloudflare/dev.log
cloudflare/login*.log
cloudflare/archive-check.json

.env

# local/deploy credentials — never committed
cloudflare/.dev.vars
cloudflare/.deploy-credentials.txt
cloudflare/.seed-parts/
