__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/

# runtime state (keep data/zenith dataset tracked)
data/*.db*
data/backups/
data/uploads/
data/server.log
server.log
# Laya model pickle + weather cache: per-environment runtime state,
