{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pharmacy-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-03",  // newest workerd supported by the pinned wrangler
  "compatibility_flags": ["nodejs_compat"],

  // ── SPA assets ──────────────────────────────────────────────────────────
  "assets": {
    "directory": "../static",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // ── The 2 independently-synchronized databases ─────────────────────────
  // DB_A (pharmacy-primary)   = the authoritative WRITER.
  // DB_B (pharmacy-secondary) = an independent D1 database kept in sync by
  // the Worker's transactional outbox (src/replication.js). NOTE: these are
  // two separate D1 databases — Cloudflare's built-in read replication can
  // only replicate replicas OF ONE database, so it cannot sync them; every
  // write captures an outbox event in the same D1 batch (transaction), and a
  // drainer applies events to DB_B atomically, idempotently, with retries.
  "d1_databases": [
    {
      "binding": "DB_A",
      "database_name": "pharmacy-primary",
      "database_id": "b1c147ab-4355-41bf-8b8f-89a5d95114a0"
    },
    {
      "binding": "DB_B",
      "database_name": "pharmacy-secondary",
      "database_id": "aa0adc62-9e69-4ee5-af2d-dcaf904f3b0e"
    }
  ],

  // ── R2: the monthly archive ──────────────────────────────────────────────
  // TEMPORARILY DISABLED: R2 not yet activated on the account (API error 10042).
  // To enable: activate R2 in the dashboard (R2 → Purchase/enable, free tier
  // includes 10 GB), then uncomment and `npx wrangler deploy` again.
  // The Worker handles the missing ARCHIVE binding gracefully (archive run
  // returns a clear "skipped" result; everything else works).
  // "r2_buckets": [
  //   { "binding": "ARCHIVE", "bucket_name": "pharmacy-archive" }
  // ],

  // ── Cron ─────────────────────────────────────────────────────────────────
  //   `* * * * *`  replication safety net: drains the outbox to DB_B every
  //                minute (normal sync happens per-request via waitUntil)
  //   `5 0 1 * *`  monthly archive at 00:05 UTC on the 1st of every month
  "triggers": {
    "crons": ["* * * * *", "5 0 1 * *"]
  },

  "observability": { "enabled": true },

  "vars": {
    "ENVIRONMENT": "production"
  }
}
