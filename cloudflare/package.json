{
  "name": "pharmacy-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute pharmacy-primary --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute pharmacy-primary --remote --file=./seed.sql",
    "db:query": "wrangler d1 execute pharmacy-primary --remote --command \"SELECT name FROM sqlite_master WHERE type='table'\"",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.86.0"
  }
}
